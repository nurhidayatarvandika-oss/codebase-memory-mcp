{
  "name": "codebase-memory-mcp",
  "version": "1.1.0",
  "description": "Persistent AI Codebase Memory MCP Server on Cloudflare Workers and D1",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute codebase-memory --local --file=./migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute codebase-memory --remote --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
